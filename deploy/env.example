# Copy to /etc/cti/env (root:cti, mode 640). Never commit real keys.
# Free keys: https://auth.abuse.ch/ (ThreatFox, URLhaus), https://nvd.nist.gov/developers/request-an-api-key
CTI_DATA_DIR=/srv/cti/data
ABUSECH_API_KEY=
NVD_API_KEY=
CTI_USER_AGENT=RMIT-Student-CTI-Dashboard/0.1 (+https://github.com/your-org/cti-dashboard; educational project)
# Optional: webhook for feed failure alerts (Discord or Slack incoming webhook)
ALERT_WEBHOOK=

# Azure OpenAI chat API (VM must have system-assigned managed identity with
# the Cognitive Services OpenAI User role on this Azure OpenAI resource).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
